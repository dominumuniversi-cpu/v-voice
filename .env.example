# VoiceTranscribator — пример настроек.
# Токен приёмника задач (задачник/CRM). Пусто — без заголовка.
VV_EXPORT_TOKEN=
# Скопируйте этот файл в secrets/.env и заполните ключи. secrets/ в git не попадает (.gitignore).
# Проверка перед запуском:  python -m vvoice.settings

# --- Распознавание речи -----------------------------------------------------
# fake — тесты без сети и денег; speechmatics/deepgram/assemblyai — облако; gigaam — своя GPU.
ASR_PROVIDER=fake
ASR_LANGUAGE=ru

# Ключи облачных сервисов. Нужен только ключ выбранного провайдера.
SPEECHMATICS_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# Своя модель (GPU): русский, с пунктуацией, MIT.
GIGAAM_MODEL=ai-sage/GigaAM-v3
GIGAAM_REVISION=e2e_rnnt

# --- Разбор разговора (LLM) --------------------------------------------------
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# --- Поведение ---------------------------------------------------------------
# true — слышим всех, но в задачи берём только реплики участников (аудио сохраняется).
MEMBERS_ONLY=true
# true — нет цитаты, нет задачи. Выключать не рекомендуется.
REQUIRE_QUOTE=true
VAD_ADAPTIVE=true
# Сколько дней хранить аудио. 0 — не удалять (не рекомендуется без причины).
DATA_RETENTION_DAYS=90

API_PORT=8900
