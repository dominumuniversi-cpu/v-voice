# Настройка сервера v-voice. Один файл на сервере — и приложение на телефоне работает без настроек.
# Заполнять только то, что реально используете. Пустая строка означает «не подключено».

# Разбор речи (обязательно для транскрибации).
# gigaam | speechmatics | deepgram | assemblyai | whisper | fake
# Допустимые: speechmatics, fake
VV_ASR_PROVIDER=
VV_ASR_KEY=
# Тариф распознавания, руб/час. Пусто — стоимость не считается (не выдумывается).
VV_ASR_PRICE_PER_HOUR=
# Предел расходов на встречу, руб. Пусто — без предела.
VV_BUDGET_PER_MEETING=

# Осмысленный разбор: задачи, решения, выжимка (обязательно для «понимать»).
# deepseek | openai | anthropic | gigachat | local | fake
# Допустимые: deepseek, anthropic, ollama, fake
VV_LLM_PROVIDER=
VV_LLM_KEY=

# Кто имеет право обращаться к серверу. Пусто — сервер открыт любому, кто знает адрес
# (режим разработки). На боевом сервере ЗАПОЛНИТЬ: иначе чужой человек может прочитать расшифровку.
# Несколько устройств — через запятую. Тот же токен вводится в настройках приложения.
VV_DEVICE_TOKENS=

# Отсечение шума и тишины перед распознаванием. on по умолчанию; off — только если мешает.
VV_NOISE_GATE=on

# Куда отправлять одобренные задачи. Нужен хотя бы один адрес, чтобы кнопка «Отправить» работала.
VV_EXPORT_HELPER_URL=
VV_EXPORT_JIRA_URL=
VV_EXPORT_BITRIX_URL=
VV_EXPORT_WEBHOOK_URL=
# Токен приёмника задач (задачник, CRM). Уходит заголовком Authorization.
VV_EXPORT_TOKEN=
# Свой ключ на каждую цель (иначе берётся общий). Helper — Bearer Прохора.
VV_EXPORT_HELPER_TOKEN=
VV_EXPORT_JIRA_TOKEN=
VV_EXPORT_BITRIX_TOKEN=

# Где и на каком порту слушать (по умолчанию 0.0.0.0:8080).
VV_HOST=
VV_PORT=

# Куда складывать записи и разборы (по умолчанию ./data рядом с сервисом).
VV_DATA_DIR=

# Другой путь к файлу настроек, если .env лежит не рядом с сервисом.
VV_ENV_FILE=

# Какую модель зовём и куда. Пусто — модель провайдера по умолчанию и его же адрес.
# Нужно, когда у Ollama свой порт или когда хочется другую модель того же провайдера.
VV_LLM_MODEL=
VV_LLM_BASE_URL=
VV_ASR_MODEL=