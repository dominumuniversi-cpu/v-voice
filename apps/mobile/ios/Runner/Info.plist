<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>v_voice</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>

    <key>CFBundleDisplayName</key>
    <string>Умный диктофон</string>

    <!-- Обязательное объяснение для пользователя и для ревью App Store. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Приложение слушает разговор, чтобы расшифровать его и подготовить краткую выжимку с задачами.</string>

    <!--
      Фоновое аудио. ВАЖНО: Apple описывает этот режим как воспроизведение звука.
      Бессрочная запись при выключенном экране на iOS платформой не гарантирована —
      см. docs/ARCHITECTURE/ARCHITECTURE.md §7 (риск, закрывается живым прогоном на устройстве).
    -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <!-- Сервер может стоять в своей сети (DIMAS). Без этого текста iOS молча не даст к нему
         постучаться — человек увидит «ошибка сети» и решит, что сломан сервер. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Приложение подключается к серверу расшифровки в вашей сети, чтобы текст не покидал контур.</string>

    <!-- Записи разговоров — чужие персональные данные: запрещаем вынос через iTunes/облако
         и перенос на новое устройство. -->
    <key>UIFileSharingEnabled</key>
    <false/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <false/>
</dict>
</plist>
