<?xml version="1.0" encoding="utf-8"?>
<!--
  Правила бэкапа и переноса данных (Android 12+).

  Почему так строго: записи разговоров — это чужие персональные данные. Без этого файла
  Android по умолчанию кладёт файлы приложения в облачный бэкап Google-аккаунта, то есть
  аудио уезжает за пределы контура без ведома человека. Закрываем оба канала: облако и перенос.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
